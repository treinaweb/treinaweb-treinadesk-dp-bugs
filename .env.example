# Copie para .env e ajuste os valores: cp .env.example .env

# PostgreSQL usado pela API e pelo seed. O banco é criado pelo
# npx prisma migrate deploy se ainda não existir.
# Os testes de integração usam o banco do .env.test.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/treinadesk?schema=public"

# Segredo do access token (JWT HS256). Obrigatório; use um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Validade do access token (formato do jsonwebtoken: 15m, 1h...). Padrão: 15m.
JWT_ACCESS_EXPIRES_IN="15m"

# Validade do refresh token, em dias. Padrão: 7.
REFRESH_TOKEN_TTL_DAYS=7

# Porta HTTP da API. Padrão: 3000 (rode o frontend Next.js na 3001).
PORT=3000

# ADMIN inicial criado por npm run seed com NODE_ENV=production (fora de
# produção o seed cria os usuários do curso, inclusive o admin).
ADMIN_EMAIL="admin@treinadesk.dev"
ADMIN_PASSWORD="troque-esta-senha"
