# Ambiente dos testes de integração (npm run test:e2e). Versionado de propósito:
# não tem segredos reais. O banco treinadesk_test é criado pelo próprio script.
# Para usar outro banco sem alterar este arquivo, crie .env.test.local
# (ignorado pelo git) com as variáveis que quiser sobrescrever.
# ATENÇÃO: npm run test:e2e apaga e recria este banco.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/treinadesk_test?schema=public"
JWT_ACCESS_SECRET="segredo-apenas-para-testes-nao-use-em-producao"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_EMAIL="admin@treinadesk.dev"
ADMIN_PASSWORD="senha123"
